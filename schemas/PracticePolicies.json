          "post_to_closed_period",
          "send_external_message",
          "close_period"
        ],
        "type": "string"
      },
      "title": "Approval Required For",
      "type": "array"
    },
    "materiality_minor": {
      "title": "Materiality Minor",
      "type": "integer"
