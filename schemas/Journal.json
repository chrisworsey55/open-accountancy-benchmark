{
  "$defs": {
    "JournalLine": {
      "additionalProperties": false,
      "description": "One debit or credit in a journal.",
      "properties": {
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "amount_minor": {
          "exclusiveMinimum": 0,
          "title": "Amount Minor",
          "type": "integer"
        },
        "bank_transaction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bank Transaction Id"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "direction": {
          "enum": [
            "dr",
            "cr"
          ],
          "title": "Direction",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "tax": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxTag"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "account_id",
        "direction",
        "amount_minor",
        "currency"
      ],
      "title": "JournalLine",
      "type": "object"
    },
    "TaxTag": {
      "additionalProperties": false,
      "description": "A typed UK VAT classification tag.\n\nJurisdiction packs validate the code and rate through their public pack hook;\nthis core model remains deliberately jurisdiction-neutral.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "const": "uk_vat",
          "title": "Kind",
          "type": "string"
        },
        "rate_bp": {
          "title": "Rate Bp",
          "type": "integer"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "rate_bp"
      ],
      "title": "TaxTag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A journal whose lines must balance per currency in minor units.",
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Id"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/JournalLine"
      },
      "minItems": 2,
      "title": "Lines",
      "type": "array"
    },
    "memo": {
      "title": "Memo",
      "type": "string"
    },
    "proposed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Proposed By"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "opening",
        "feed_classification",
        "proposal",
        "adjustment"
      ],
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "posted",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity_id",
    "date",
    "memo",
    "source",
    "status",
    "lines",
    "proposed_by",
    "approval_id"
  ],
  "title": "Journal",
  "type": "object"
}
