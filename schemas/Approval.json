{
  "$defs": {
    "ClosePeriodDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for a close-period approval.",
      "properties": {
        "kind": {
          "const": "close_period",
          "title": "Kind",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "period_id"
      ],
      "title": "ClosePeriodDescriptor",
      "type": "object"
    },
    "PostJournalDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for a post-journal approval.",
      "properties": {
        "journal_id": {
          "title": "Journal Id",
          "type": "string"
        },
        "kind": {
          "const": "post_journal",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "journal_id"
      ],
      "title": "PostJournalDescriptor",
      "type": "object"
    },
    "PostToClosedPeriodDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for a post-to-closed-period approval.",
      "properties": {
        "journal_id": {
          "title": "Journal Id",
          "type": "string"
        },
        "kind": {
          "const": "post_to_closed_period",
          "title": "Kind",
          "type": "string"
        },
        "period_id": {
          "title": "Period Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "journal_id",
        "period_id"
      ],
      "title": "PostToClosedPeriodDescriptor",
      "type": "object"
    },
    "SendMessageDescriptor": {
      "additionalProperties": false,
      "description": "Descriptor for a send-message approval.",
      "properties": {
        "draft_message_id": {
          "title": "Draft Message Id",
          "type": "string"
        },
        "kind": {
          "const": "send_external_message",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "draft_message_id"
      ],
      "title": "SendMessageDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A requested, granted, rejected, or expired approval.",
  "properties": {
    "action_descriptor": {
      "discriminator": {
        "mapping": {
          "close_period": "#/$defs/ClosePeriodDescriptor",
          "post_journal": "#/$defs/PostJournalDescriptor",
          "post_to_closed_period": "#/$defs/PostToClosedPeriodDescriptor",
          "send_external_message": "#/$defs/SendMessageDescriptor"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PostJournalDescriptor"
        },
        {
          "$ref": "#/$defs/PostToClosedPeriodDescriptor"
        },
        {
          "$ref": "#/$defs/SendMessageDescriptor"
        },
        {
          "$ref": "#/$defs/ClosePeriodDescriptor"
        }
      ],
      "title": "Action Descriptor"
    },
    "approved_draft_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved Draft Digest"
    },
    "approver_role": {
      "enum": [
        "client_contact",
        "bookkeeper",
        "staff_accountant",
        "reviewer",
        "partner",
        "admin",
        "agent"
      ],
      "title": "Approver Role",
      "type": "string"
    },
    "engagement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engagement Id"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "post_journal",
        "post_to_closed_period",
        "send_external_message",
        "close_period"
      ],
      "title": "Kind",
      "type": "string"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Provenance Refs",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "requested",
        "granted",
        "rejected",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "requested_by",
    "approver_role",
    "action_descriptor",
    "rationale",
    "provenance_refs",
    "status"
  ],
  "title": "Approval",
  "type": "object"
}
